{
  "name": "dilijump",
  "version": "3.0.1",
  "description": "DiliJump — a Doodle Jump–style 2D web game starring the Dlicom mascot. Jump, collect DLI coins, climb the leaderboard.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "levsage",
  "homepage": "https://levsage.github.io/DiliJump/",
  "repository": {
    "type": "git",
    "url": "https://github.com/levsage/DiliJump.git"
  },
  "bugs": {
    "url": "https://github.com/levsage/DiliJump/issues"
  },
  "keywords": [
    "game",
    "html5",
    "canvas",
    "doodle-jump",
    "dlicom",
    "dli",
    "platformer"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "sprites": "python3 tools/process_sprites.py art/poses public/assets/sprites 320",
    "sprites:sheets": "python3 tools/process_sheets.py",
    "test:db": "bash supabase/tests/run-local.sh",
    "check:supabase": "node --env-file-if-exists=.env.local tools/supabase-healthcheck.mjs",
    "test:e2e": "playwright test",
    "og-image": "node tools/og/render.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0"
  }
}
