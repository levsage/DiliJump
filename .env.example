# Copy to `.env.local` (git-ignored) and fill in from
# Supabase Dashboard → Project Settings → API Keys / Data API.
#
# Leave empty to use the offline (localStorage) leaderboard.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) — safe to ship in the browser.
# Older projects: you may use the legacy "anon" key here instead.
# NEVER use a secret / service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
